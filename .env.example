# Illustrative local settings only. Copy to .env; replace locally.
DATABASE_URL=postgresql://campusresolve:CHANGE_ME@localhost:5432/campusresolve
AUTH_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_SECRET
AI_MODE=rules
PAID_SERVICES_ALLOWED=false
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Frontend dev proxy target; not exposed as a credential.
BACKEND_URL=http://127.0.0.1:8000
